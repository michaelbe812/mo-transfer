# cp deploy/azure/.env.example deploy/azure/.env  (gitignored), fill in, then: set -a; source deploy/azure/.env; set +a
# Tokens/passwords: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
RESOURCE_GROUP=rg-nx-tooling
LOCATION=westeurope
PREFIX=nx

# cache (nx-remote-cache-custom); several tokens comma-separated
NX_CACHE_CI_TOKENS=
NX_CACHE_READ_ONLY_TOKENS=
NX_CACHE_DEV_TOKENS=
NX_CACHE_METRICS_TOKEN=

# metrics (collector, Postgres, Grafana)
COLLECTOR_TOKENS=
POSTGRES_ADMIN_PASSWORD=
GRAFANA_READER_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS_VIEWER=false

# only parts: DEPLOY_CACHE=false (cache on your own server → CACHE_METRICS_TARGET=nx-cache.example.com:443) / DEPLOY_METRICS=false
DEPLOY_CACHE=true
DEPLOY_METRICS=true
CACHE_METRICS_TARGET=
