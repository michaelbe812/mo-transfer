{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openapi-clients.json",
  "description": "Generated OpenAPI clients, read by the OpenAPI executors (at run time), the plugin, the client generator and verify. Key = client path below libsDir. Each entry is a json input (fields) of its client's generate targets: changing it invalidates that client only.",
  "type": "object",
  "definitions": {
    "adapterId": {
      "type": "string",
      "anyOf": [
        {
          "enum": ["openapi-tools", "hey-api", "nx-plugin-openapi", "command"]
        },
        {
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "consumer adapter: a key of `adapters`"
        }
      ]
    },
    "moduleSpecifier": {
      "type": "string",
      "description": "Workspace path (./tools/x.ts — its folder becomes a cache input), npm package (@acme/x — externalDependency) or builtin:<id>."
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultAdapter": {
      "$ref": "#/definitions/adapterId",
      "default": "openapi-tools"
    },
    "settings": {
      "type": "object",
      "description": "Workspace settings (all optional, defaults = the values of mo-transfer). A json input of every generate target.",
      "properties": {
        "libsDir": {
          "type": "string",
          "default": "libs"
        },
        "clientFolder": {
          "type": "string",
          "default": "generated",
          "description": "reserved folder in a client path"
        },
        "outputDir": {
          "type": "string",
          "default": "generated",
          "description": "gitignored subfolder of src/ per client lib"
        },
        "aliasPrefix": {
          "type": "string",
          "default": "@mo-transfer/"
        },
        "sharedScope": {
          "type": "string",
          "default": "shared"
        },
        "specFiles": {
          "$ref": "#/definitions/stringList",
          "default": ["openapi.yaml", "openapi.json"]
        },
        "scaffold": {
          "$ref": "#/definitions/moduleSpecifier",
          "description": "Lib scaffold of the client generator (defineScaffold). Default: built-in (project.json + tsconfig.json + paths)."
        },
        "features": {
          "type": "object",
          "description": "Experimental features, off by default. A client using a disabled feature fails its generate target with a hint; verify reports it.",
          "properties": {
            "overlays": {
              "type": "boolean",
              "default": false,
              "description": "EXPERIMENTAL: pipeline.overlays (OpenAPI Overlay 1.0, JSONPath subset)"
            }
          },
          "additionalProperties": false
        },
        "testing": {
          "type": "object",
          "properties": {
            "mocks": {
              "enum": ["none", "schema-faker", "orval"],
              "default": "none",
              "description": "mocks engine of the testing libs: none = scaffold only (schema.ts + typed <client>Http, no fake data, no generated handlers); schema-faker = + get<Op>…Mock factories and <client>Handlers (faker); orval is deprecated (removed next iteration)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "description": "Consumer adapters (id → module + declarative cache metadata). The plugin never imports them. Same id as a built-in replaces it.",
      "propertyNames": {
        "pattern": "^([a-z][a-z0-9-]*|\\$.*)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "module": {
            "$ref": "#/definitions/moduleSpecifier"
          },
          "packages": {
            "$ref": "#/definitions/stringList",
            "description": "npm packages whose version is a cache input"
          },
          "inputs": {
            "$ref": "#/definitions/stringList",
            "description": "further cache inputs, {workspaceRoot}/…"
          },
          "runtime": {
            "$ref": "#/definitions/stringList",
            "description": "runtime cache inputs, e.g. java -version 2>&1"
          },
          "options": {
            "type": "object",
            "description": "options for every client of this adapter (over the module defaults)"
          }
        },
        "required": ["module"],
        "additionalProperties": false
      }
    },
    "clients": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*){1,2}$",
        "description": "<clientFolder>/<name> or <domain>/<clientFolder>/<name>"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {
            "$ref": "#/definitions/adapterId"
          },
          "url": {
            "type": "string",
            "description": "Source for update-spec only. generate-api-client reads the committed spec file."
          },
          "options": {
            "type": "object",
            "description": "Adapter options, merged over the adapter defaults."
          },
          "layout": {
            "enum": ["merged-core"],
            "description": "core merged into the api lib (no core lib). Default: types/api/core."
          },
          "pipeline": {
            "type": "object",
            "properties": {
              "overlays": {
                "$ref": "#/definitions/stringList",
                "description": "EXPERIMENTAL (settings.features.overlays): OpenAPI Overlay 1.0 files relative to the client folder, applied in order (cache inputs only with the flag on)"
              },
              "transforms": {
                "type": "array",
                "description": "Code hooks after classify (defineTransform); module folder/package = cache input",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/moduleSpecifier"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "module": {
                          "$ref": "#/definitions/moduleSpecifier"
                        },
                        "options": {
                          "type": "object"
                        }
                      },
                      "required": ["module"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "format": {
                "type": "boolean",
                "default": false,
                "description": "prettier on every generated file"
              },
              "testing": {
                "anyOf": [
                  {
                    "enum": ["msw", false]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mocks": {
                        "enum": ["none", "schema-faker", "orval"]
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "default": "msw",
                "description": "false: no testing lib; { mocks }: engine (default settings.testing.mocks = none; schema-faker opt-in, orval deprecated)"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
