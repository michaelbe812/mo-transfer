{
  "name": "@mo-transfer/tooling-openapi",
  "version": "0.1.0",
  "private": true,
  "description": "Generierte OpenAPI-Clients für Nx: Pipeline (spec/Overlays → generate → classify → transform → split → barrel → finalize → write), Adapter-SPI v1, Crystal-Plugin (generate-api-client/generate-api-testing/update-spec), Executoren, Generator client.",
  "license": "MIT",
  "keywords": [
    "nx",
    "nx-plugin",
    "openapi",
    "codegen",
    "angular"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./src/adapter.ts",
    "./adapter-testing": "./src/adapter-testing.ts",
    "./clients": "./src/clients.ts",
    "./plugin": "./src/plugin/openapi-clients.ts",
    "./package.json": "./package.json"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@nx/devkit": ">=23.0.0",
    "nx": ">=23.0.0",
    "typescript": ">=5.5.0",
    "msw": ">=2.0.0",
    "@faker-js/faker": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mo-transfer/tooling-conventions": "workspace:*"
  }
}
