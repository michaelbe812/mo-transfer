# Generated once by deploy.sh on the host (secrets via `openssl rand -hex 32`); never commit the real file.
# Where MinIO keeps the cache entries; must exist (e.g. on an external SSD), Docker will not create it.
NX_CACHE_DATA_DIR=/Volumes/DevSSD/nx-cache/minio-data

MINIO_ROOT_USER=nxcache
MINIO_ROOT_PASSWORD=<secret>

# comma-separated, one token per person/machine (revocable one by one)
NX_CACHE_CI_TOKENS=<secret>
NX_CACHE_DEV_TOKENS=<secret-macbook>,<secret-mac-mini>
NX_CACHE_READ_ONLY_TOKENS=<secret>
NX_CACHE_METRICS_TOKEN=<secret>

POSTGRES_PASSWORD=<secret>
COLLECTOR_TOKENS=<secret>
GRAFANA_ADMIN_PASSWORD=<secret>

# optional limits (defaults shown)
# NX_CACHE_RETENTION_DAYS=5
# NX_CACHE_QUOTA_GIB=100
# NX_CACHE_EVICT_HIGH_GIB=90
# NX_CACHE_EVICT_LOW_GIB=80
