{
  "name": "nx-metrics",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nx-metrics/src",
  "tags": ["type:tooling", "tooling:nx-metrics"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [],
      "inputs": ["default", "^default", { "externalDependencies": ["typescript"] }],
      "options": {
        "command": "tsc -p packages/nx-metrics/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default", { "externalDependencies": ["vitest", "typescript"] }],
      "options": {
        "command": "vitest run --config packages/nx-metrics/vitest.config.mts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "{projectRoot}/scripts/**/*", { "externalDependencies": ["typescript"] }],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npm run build",
        "cwd": "packages/nx-metrics"
      }
    }
  }
}
