{
  "name": "openapi-bench-ng-openapi-gen",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/openapi-bench/generators/ng-openapi-gen",
  "tags": [
    "scope:bench"
  ],
  "targets": {
    "test-runtime": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "tsConfig": "{projectRoot}/tsconfig.spec.json",
        "runnerConfig": "packages/openapi-bench/vitest.runtime.config.mts",
        "include": [
          "tests/**/*.spec.ts"
        ],
        "browsers": [
          "chromiumHeadless"
        ],
        "watch": false,
        "buildTarget": "openapi-bench-ng-openapi-gen:bench-build:development"
      }
    },
    "bench-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node generate.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "bench-build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "options": {
        "project": "{projectRoot}/ng-package.json",
        "tsConfig": "{projectRoot}/tsconfig.spec.json"
      },
      "configurations": {
        "development": {}
      }
    }
  }
}
